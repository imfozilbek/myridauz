{
  "name": "platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p . && pnpm -r --parallel typecheck",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:text": "node scripts/check-text.mjs",
    "check:secrets": "gitleaks git --no-banner --redact",
    "audit": "pnpm audit --audit-level moderate",
    "e2e": "playwright test --project=smoke",
    "screenshots": "playwright test --project=screenshots",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:coverage && pnpm check:text && pnpm check:secrets && pnpm audit"
  },
  "devDependencies": {
    "@platform/brands": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/i18n": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "overrides": {
      "valibot": "1.4.2"
    }
  }
}
