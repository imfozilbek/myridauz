{
  "name": "platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile .tsc/info && pnpm -r --parallel typecheck --incremental --tsBuildInfoFile .tsc/info",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:text": "node scripts/check-text.mjs",
    "check:secrets": "gitleaks git --no-banner --redact",
    "audit": "pnpm audit --audit-level moderate",
    "e2e": "playwright test --project=smoke",
    "screenshots": "playwright test --project=screenshots",
    "deploy": "node scripts/deploy.mjs",
    "map-data": "node scripts/map-data.mjs",
    "setup-bots": "node scripts/setup-bots.mjs",
    "stand": "node scripts/stand/stand.mjs",
    "stand:check": "node scripts/stand/check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:coverage && pnpm check:text && pnpm check:secrets && pnpm audit"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@platform/api-client": "workspace:*",
    "@platform/brands": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/i18n": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  },
  "pnpm": {
    "overrides": {
      "valibot": "1.4.2",
      "undici@>=7.28.0 <7.29.1": "7.29.1"
    }
  }
}
