{
  "name": "platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile .tsc/info && pnpm -r --parallel typecheck --incremental --tsBuildInfoFile .tsc/info",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "check:text": "node scripts/check-text.mjs",
    "check:secrets": "gitleaks git --no-banner --redact",
    "audit": "pnpm audit --audit-level moderate",
    "e2e": "playwright test --project=smoke",
    "screenshots": "playwright test --project=screenshots",
    "deploy": "node scripts/deploy.mjs",
    "map-data": "node scripts/map-data.mjs",
    "setup-bots": "node scripts/setup-bots.mjs",
    "keys": "node scripts/keys.mjs",
    "stand": "node scripts/stand/stand.mjs",
    "stand:check": "node scripts/stand/check.mjs",
    "stand:walk": "STAND_WALK=1 STAND_SHARDS=4 node scripts/stand/check.mjs --area walk",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:coverage && pnpm check:text && pnpm check:secrets && pnpm audit"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@platform/api-client": "workspace:*",
    "@platform/brands": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/i18n": "workspace:*",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "pnpm": {
    "overrides": {
      "valibot": "1.4.2",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5",
      "qs@<6.16.1": "6.16.1",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "zod@<4.6.6": "4.6.6"
    },
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
