{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "playwright": {
        "config": ["playwright.config.ts", "playwright.stand.config.ts"]
      }
    },
    "apps/backend": {
      "entry": ["src/index.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "brands/*/brand-kit": {
      "entry": ["tools/map-data.mjs", "region-drawings.mjs"]
    },
    "apps/landing": {
      "entry": ["src/prerender.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
