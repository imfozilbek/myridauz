{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/backend": {
      "entry": ["src/index.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "brands/*/brand-kit": {
      "entry": ["tools/map-data.mjs"]
    },
    "apps/landing": {
      "entry": ["src/prerender.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
