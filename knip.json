{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["wrangler"]
    },
    "apps/backend": {
      "entry": ["src/index.ts"]
    },
    "brands/*/brand-kit": {
      "entry": ["tools/map-data.mjs"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
